[Unit]
Description=Read-only CAN to MQTT telemetry bridge
Documentation=https://github.com/askrejans/can-to-mqtt
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=canmqtt
Group=canmqtt
ExecStart=/usr/local/bin/can-to-mqtt --config /etc/can-to-mqtt/settings.toml daemon --systemd --pid-file /run/can-to-mqtt/bridge.pid
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
RuntimeDirectory=can-to-mqtt
RuntimeDirectoryMode=0700
StateDirectory=can-to-mqtt
StateDirectoryMode=0700
Environment=XDG_STATE_HOME=/var/lib/can-to-mqtt
Environment=CAN2MQTT_LOG_LEVEL=info
EnvironmentFile=-/etc/default/can-to-mqtt
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN AF_NETLINK
CapabilityBoundingSet=
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
