# Optional /etc/default/can-to-mqtt (owner-only if it contains a password).
# Prefer mqtt_password_file in the private service configuration.
# CAN2MQTT_CAN_INTERFACE=can0
# CAN2MQTT_MQTT_HOST=127.0.0.1
# CAN2MQTT_MQTT_PORT=1883
# CAN2MQTT_CAR=rally-86
# CAN2MQTT_MQTT_BASE_TOPIC=/custom/can
# CAN2MQTT_HTTP_PORT=9093
CAN2MQTT_LOG_LEVEL=info
