# Environment variables for can-to-mqtt service
# Place this file at /etc/default/can-to-mqtt

# CAN interface to use
#CAN2MQTT_CAN_INTERFACE=can0

# MQTT broker configuration
#CAN2MQTT_MQTT_HOST=localhost
#CAN2MQTT_MQTT_PORT=1883
#CAN2MQTT_MQTT_USERNAME=your_username
#CAN2MQTT_MQTT_PASSWORD=your_password

# Topic namespace: car slug -> /g86/<car>/obd; an explicit base topic wins
#CAN2MQTT_CAR=golf86
#CAN2MQTT_MQTT_BASE_TOPIC=/GOLF86/ECU/

# Logging level (trace, debug, info, warn, error)
CAN2MQTT_LOG_LEVEL=info

# Configuration file path (optional)
#CAN2MQTT_CONFIG_FILE=/etc/g86-car-telemetry/can-to-mqtt.toml
